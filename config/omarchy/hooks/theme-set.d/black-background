#!/bin/bash
# The desktop stays black; the theme's wallpaper moves into WezTerm, the main
# terminal behind the desktop (config/hypr/main-terminal.lua). WezTerm reads
# ~/.local/state/wezterm/background.
black="$(dirname "$(readlink -f "$0")")/../../black.png"
black="$(readlink -f "$black")"
current="$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true)"
if [[ -f $current && $current != "$black" ]]; then
  mkdir -p "$HOME/.local/state/wezterm"
  ln -sfn "$current" "$HOME/.local/state/wezterm/background"
fi
omarchy theme bg set "$black"
exit 0
